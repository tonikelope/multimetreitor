          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="865" y="505" /><mxPoint x="865" y="340" /></Array>
          </mxGeometry>
        </mxCell>
        <!-- history persistence -->
        <mxCell id="f9" value="save" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#5E35B1;strokeWidth=2;fontSize=11;fontColor=#5E35B1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="history" target="eeprom">
