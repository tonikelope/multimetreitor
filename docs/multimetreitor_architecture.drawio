          <mxGeometry x="620" y="130" width="210" height="40" as="geometry" />
        </mxCell>
        <mxCell id="keepNTP" value="keepSyncNTP()&#10;resync every 24h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="200" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="keepMQTT" value="keepMQTTAlive()&#10;reconnect + mqttClient.loop()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="280" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="handleOTA" value="handleOTA()&#10;ArduinoOTA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="360" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="webserver" value="server.handleClient()&#10;ESP8266WebServer :80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FF8F00;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="440" width="210" height="50" as="geometry" />
        </mxCell>

        <!-- shared state -->
        <mxCell id="state" value="Global state&#10;voltage / current / power / energy /&#10;pf / frequency / icpCarga&#10;+ config (AppConfig)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#757575;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="520" width="210" height="140" as="geometry" />
        </mxCell>

        <!-- ================= EXTERNAL NET (right) ================= -->
