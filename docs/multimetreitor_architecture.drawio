        <mxCell id="f5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#455A64;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="composeLCD" target="publish">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- outputs (routed through the corridor between the Hardware and core groups, x=270) -->
