<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="MULTIMETREITOR - Architecture" id="multimetreitor-arch">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="MULTIMETREITOR — Firmware architecture &amp; data flow (ESP8266)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#1A237E;" vertex="1" parent="1">
          <mxGeometry x="340" y="16" width="720" height="36" as="geometry" />
        </mxCell>

        <!-- ================= EXTERNAL (left) ================= -->
        <mxCell id="grp_hw" value="Hardware / Physical" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9E9E9E;dashed=1;verticalAlign=top;fontStyle=2;fontColor=#616161;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="220" height="430" as="geometry" />
        </mxCell>

        <mxCell id="pzem" value="PZEM-004T v3&#10;(UART sensor)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lcd" value="16x2 LCD (I2C 0x27)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="buzzer" value="Buzzer (D7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#AD1457;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="325" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="eeprom" value="EEPROM&#10;(AppConfig + 24-month history)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="390" width="160" height="90" as="geometry" />
        </mxCell>

        <!-- ================= CORE LOOP (center) ================= -->
        <mxCell id="grp_core" value="loop() — cooperative scheduler (non-blocking, millis-based)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1565C0;verticalAlign=top;fontStyle=1;fontColor=#1565C0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="560" height="600" as="geometry" />
        </mxCell>

        <mxCell id="readSensors" value="readSensorsAndTriggerAlerts()&#10;every config.refreshInterval ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="130" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="computeICP" value="computeICP()&#10;thermal-load model (0-100%)&#10;7-segment log trip curve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="220" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="evalAlerts" value="evaluateAlerts()&#10;ICP &gt; overvolt &gt; undervolt &gt; consumption" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="320" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="composeLCD" value="composeLCDLines() / driveBuzzer()&#10;render 2x16 + beep on alert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="410" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="publish" value="publishAllMQTT()&#10;unified JSON, retained" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="500" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="history" value="updateMonthlyEnergyHistory()&#10;hourly: month change → reset energy,&#10;save history (EEPROM cooldown 1h)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="590" width="240" height="70" as="geometry" />
