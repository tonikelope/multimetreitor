        </mxCell>
        <mxCell id="f7" value="beep" style="html=1;rounded=0;endArrow=classic;strokeColor=#AD1457;strokeWidth=2;fontSize=11;fontColor=#AD1457;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="evalAlerts" target="buzzer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- JSON publish: rises into the corridor below the keepers (y=518), then up the gap (x=865) to the broker -->
