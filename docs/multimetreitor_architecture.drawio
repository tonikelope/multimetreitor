          <mxGeometry x="1090" y="125" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ntp" value="NTP server&#10;pool.ntp.org (CET/CEST)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1090" y="200" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="broker" value="MQTT broker&#10;:1883&#10;electricidad/casa/estado (retained)&#10;.../icp · multimetreitor/status · /serial" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="265" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="otaclient" value="OTA uploader&#10;(arduino / espota)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1090" y="360" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="Web browser&#10;config panel + /json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FF8F00;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1090" y="440" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rainmeter" value="Rainmeter skin&#10;(subscribes to state topic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1090" y="560" width="200" height="60" as="geometry" />
