        <mxCell id="n3" value="MQTT pub/sub&#10;+ ICP recovery" style="html=1;rounded=0;endArrow=classic;startArrow=classic;strokeColor=#0277BD;strokeWidth=2;fontSize=11;fontColor=#0277BD;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.444;entryDx=0;entryDy=0;" edge="1" parent="1" source="keepMQTT" target="broker">
