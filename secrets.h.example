#ifndef SECRETS_H
#define SECRETS_H

// ====================================================================
//  Template for the private credentials file.
//
//  SETUP:
//    1. Copy this file to "secrets.h" (same folder as the .ino).
//    2. Replace the placeholder values with your own WiFi credentials.
//
//  "secrets.h" is git-ignored, so your real credentials never get
//  committed. This .example file is the one that is versioned.
// ====================================================================

#define WIFI_SSID      "YOUR_WIFI_SSID"
#define WIFI_PASSWORD  "YOUR_WIFI_PASSWORD"

#endif  // SECRETS_H
